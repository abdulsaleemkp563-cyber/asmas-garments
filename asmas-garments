<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Asma's Garments</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body{
  margin:0;
  font-family: Arial, sans-serif;
  background:#f5f5f5;
}

/* Header */
header{
  background:#0090ff;
  color:white;
  padding:15px;
  text-align:center;
}

.logo{
  margin:0;
  font-size:32px;
}

/* Banner */
.banner{
  background:lightgreen;
  padding:20px;
  text-align:center;
  font-size:20px;
  font-weight:bold;
}

/* Products */
.products{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:15px;
  padding:15px;
}

.product{
  background:white;
  border-radius:8px;
  padding:10px;
  text-align:center;
  box-shadow:0 2px 5px rgba(0,0,0,0.1);
}

.product img{
  width:100%;
  height:220px;
  object-fit:cover;
  border-radius:6px;
}

.product h3{
  margin:10px 0 5px;
}

.price{
  color:green;
  font-weight:bold;
}

/* WhatsApp Button inside product */
.buy-btn{
  display:inline-block;
  margin-top:8px;
  background:#25D366;
  color:white;
  padding:8px 12px;
  border-radius:20px;
  text-decoration:none;
  font-size:14px;
}

/* Floating WhatsApp */
.whatsapp-float{
  position:fixed;
  bottom:20px;
  right:20px;
  background:#25D366;
  color:white;
  padding:15px 20px;
  border-radius:50px;
  text-decoration:none;
  font-weight:bold;
  box-shadow:0 4px 10px rgba(0,0,0,0.3);
}

/* Footer */
footer{
  background:#222;
  color:white;
  text-align:center;
  padding:10px;
  font-size:14px;
}
</style>
</head>

<body>

<header>
  <h1 class="logo">Asma's Garments</h1>
  <p>Quality Dresses at Best Price</p>
</header>

<div class="banner">
  📦 Online Orders Available | 📲 WhatsApp Order
</div>

<section class="products">

  <!-- Product 1 -->
  <div class="product">
    <img src="https://via.placeholder.com/300x400?text=Dress+1">
    <h3>Women Dress</h3>
    <div class="price">₹999</div>
    <a class="buy-btn" href="https://wa.me/919037531655?text=I want to order Women Dress ₹999">
      Order on WhatsApp
    </a>
  </div>

  <!-- Product 2 -->
  <div class="product">
    <img src="https://via.placeholder.com/300x400?text=Dress+2">
    <h3>Kurti Set</h3>
    <div class="price">₹1299</div>
    <a class="buy-btn" href="https://wa.me/919037531655?text=I want to order Kurti Set ₹1299">
      Order on WhatsApp
    </a>
  </div>

  <!-- Product 3 -->
  <div class="product">
    <img src="https://via.placeholder.com/300x400?text=Dress+3">
    <h3>Kids Dress</h3>
    <div class="price">₹699</div>
    <a class="buy-btn" href="https://wa.me/919037531655?text=I want to order Kids Dress ₹699">
      Order on WhatsApp
    </a>
  </div>

</section>

<a class="whatsapp-float" href="https://wa.me/919037531655" target="_blank">
  📲 WhatsApp
</a>

<footer>
  © 2026 Asma's Garments | All Rights Reserved
</footer>

</body>
</html>
